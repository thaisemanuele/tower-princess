    "gitDecoration.stageModifiedResourceForeground": "#f4c76a",
    "gitDecoration.untrackedResourceForeground": "#c9a7e8",
    "gitDecoration.addedResourceForeground": "#c9a7e8",
    "gitDecoration.renamedResourceForeground": "#c9a7e8",
    "gitDecoration.deletedResourceForeground": "#e8798f",
    "gitDecoration.stageDeletedResourceForeground": "#e8798f",
    "gitDecoration.conflictingResourceForeground": "#e9a6c3",
