    "terminal.ansiBlue": "#9b8cf2",
    "terminal.ansiMagenta": "#a66cff",
    "terminal.ansiCyan": "#c9a7e8",
    "terminal.ansiWhite": "#d4c8e4",
    "terminal.ansiBrightBlack": "#7d6f96",
    "terminal.ansiBrightRed": "#f29cae",
