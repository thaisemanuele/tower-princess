    "modernPanel.border": "#1e1730",
    "modernUI.shellBackground": "#100c18",
    "terminalCursor.foreground": "#f4c76a",
    "terminal.selectionBackground": "#8732d455",
    "terminal.findMatchBackground": "#f4c76a55",
